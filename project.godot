; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Free Cardware: Rebuild"
run/main_scene="uid://c6xs05vwdl5gk"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://1xpv2g37ciqr"
config/macos_native_icon="res://img/icons/icon.icns"
config/windows_native_icon="res://img/icons/icon.ico"

[autoload]

SettingsPreload="*uid://ktr6hh5bjulm"
DebugLogger="*uid://dyverlwebx3mp"
CardLibrary="*uid://bu45euo0jrmfx"
EnemyLibrary="*uid://dxbk2i2hj2u6t"
DiscordActivity="*uid://01rja77q8hr2"
EventLibrary="*uid://hm11i2hsk27y"
SexLibrary="*uid://cftu44xus7klg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="uid://dgm2o8bj8sjw7"

[editor]

script/search_in_file_extensions=PackedStringArray("gd", "gdshader", "tres", "tscn")

[input]

